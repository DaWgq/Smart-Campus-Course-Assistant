# ============================================================
#  Python / 后端
# ============================================================

# 虚拟环境
.venv/
venv/
env/
ENV/

# Python 缓存
__pycache__/
*.py[cod]
*$py.class
*.so

# 打包产物
build/
dist/
*.egg-info/
.eggs/

# 测试与类型缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 本地数据库（由 run_seed.py 或 sql/ 脚本生成）
*.db
*.sqlite3

# ------------------------------------------------------------
#  密钥与本地配置（绝不能提交）
# ------------------------------------------------------------
.env
.env.local
.env.*.local
!.env.example

# ------------------------------------------------------------
#  Chroma 向量库（由 python run_seed.py 生成）
# ------------------------------------------------------------
backend/chroma_data/
chroma_data/

# ============================================================
#  前端 / Node
# ============================================================

# 依赖（151MB+，必须忽略）
node_modules/
.pnpm-store/
.yarn/cache
.yarn/install-state.gz

# 构建产物
dist/
build/
.vite/
*.local

# 缓存
.cache/
.eslintcache
.stylelintcache

# 环境变量（Vite 用 VITE_ 前缀）
.env.front
.env.front.*
!.env.front.example

# ============================================================
#  IDE / 编辑器
# ============================================================

# PyCharm / IntelliJ
.idea/
!.idea/.gitignore
*.iml
*.iws
*.ipr

# JetBrains AI Debugger 数据集（体积大且无意义）
.jbeval/

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/c_cpp_properties.json
!.vscode/*.code-snippets

# 其他编辑器
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# ============================================================
#  日志与运行时
# ============================================================

logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Windows 临时文件
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ============================================================
#  杂项
# ============================================================

# 空目录占位（若使用 git 保留空目录）
!.gitkeep

# Office / 设计工具临时文件
*.tmp
*.bak
*~.swp