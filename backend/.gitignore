# ============================================================
#  后端专用忽略规则（与根目录 .gitignore 配合使用）
# ============================================================

# 环境变量：包含 DeepSeek API Key 等敏感信息，严禁提交
.env
.env.local
.env.*.local
!.env.example

# Python 缓存
__pycache__/
*.py[cod]
*$py.class

# 虚拟环境
.venv/
venv/
env/

# Chroma 向量库（由 python run_seed.py 生成）
chroma_data/

# 临时测试脚本
_t.py
_d.py
_z.py
_f.py
_e.py
_migrate*.py
_run*.py
test_*.py
*_test.py

# 本地数据库
*.db
*.sqlite3

# 日志
*.log
logs/

# 编辑器
.idea/
.vscode/
*.iml

# 系统文件
.DS_Store
Thumbs.db
Desktop.ini